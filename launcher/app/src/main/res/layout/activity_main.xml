<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="?attr/tnBg1">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Optional wallpaper caption shelf. Hidden by default; the setting can still enable it. -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:visibility="gone"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/tnText"
            android:textSize="36sp"
            android:fontFamily="@font/outfit"
            android:textFontWeight="500"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- The country/state close under the name, and the description a little further below it. -->
        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/tnText"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:textFontWeight="500"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/tnMuted"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:textFontWeight="400"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Information rail: daily ayah on the left, prayer times on the right. Aligned with the dock. -->
    <com.gathin.tvhome.EqualHeightRow
        android:id="@+id/islamicShelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:alpha="1">

        <LinearLayout
            android:id="@+id/ayahColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Ayat / Doa Harian (WeeklyAyah) -->
            <LinearLayout
                android:id="@+id/ayahBlock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="start"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/tn_card"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ayahLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doa harian  •  Ayat pilihan"
                    style="@style/TenangEyebrow"
                    android:textColor="?attr/tnMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:textFontWeight="500"
                    android:letterSpacing="0.04"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/ayahArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"
                    android:maxWidth="400dp"
                    android:gravity="right"
                    android:textDirection="rtl"
                    android:textColor="?attr/tnWarm"
                    android:textSize="22sp"
                    android:fontFamily="@font/amiri_quran"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/ayahText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="start"
                    android:maxWidth="400dp"
                    android:gravity="start"
                    android:textColor="?attr/tnText"
                    android:alpha="0.9"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:textFontWeight="300"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/infoDivider"
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/prayerBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.16"
            android:orientation="vertical"
            android:gravity="start"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/tn_card"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <!-- Waktu Solat header -->
            <TextView
                android:id="@+id/prayerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TenangEyebrow"
                android:textColor="?attr/tnMuted"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:textFontWeight="500"
                android:letterSpacing="0.04"
                android:includeFontPadding="false" />

            <!-- Waktu Solat table -->
            <LinearLayout
                android:id="@+id/prayerTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblSubuh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subuh"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeSubuh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblSyuruk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Syuruk"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeSyuruk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblZohor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zohor"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeZohor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblAsar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asar"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeAsar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblMaghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeMaghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/lblIsyak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isyak"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500" />
                    <TextView
                        android:id="@+id/timeIsyak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="?attr/tnAccent"
                        android:textSize="22sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="300" />
                </LinearLayout>
            </LinearLayout>

            <!-- Countdown to the next prayer: previous name, a bar, "Subuh dalam 5j 36m". -->
            <LinearLayout
                android:id="@+id/prayerCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/prayerPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="?attr/tnMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/tn_bar_track">
                    <View
                        android:id="@+id/prayerBarFill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tn_bar_fill"
                        android:scaleX="0.13"
                        android:transformPivotX="0dp" />
                </FrameLayout>
                <TextView
                    android:id="@+id/prayerNextIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="?attr/tnMuted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </LinearLayout>
    </com.gathin.tvhome.EqualHeightRow>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Row: Clock & Date on Left, Menu Buttons on Right (SEBARIS DENGAN MASA) -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="?attr/tnText"
                    android:textSize="90sp"
                    android:fontFamily="@font/outfit_extralight"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false" />

                <!-- 1:2 layout: 1 jam on left, 2 stacked rows on right (atas: am/pm, bawah: tarikh) -->
                <LinearLayout
                    android:id="@+id/dateBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <!-- Atas: AM/PM (e.g. PG / PTG / MLM) -->
                    <TextView
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="?attr/tnMuted"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500"
                        android:letterSpacing="0.23"
                        android:textAllCaps="true" />

                    <!-- Bawah: Tarikh (e.g. 23 OKT 2026) -->
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:textColor="?attr/tnText"
                        android:textSize="19sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="0.03" />
                    <!-- Greeting by time of day ("Selamat malam ✦"), set by HomeText. -->
                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="?attr/tnAccent"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit" />

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="?attr/tnText"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bawah Jam: Row Cuaca & Amaran Cuaca Buruk (Sebelah Weather) -->
            <LinearLayout
                android:id="@+id/weatherRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignParentStart="true"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/weatherAirQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/tn_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="?attr/tnText"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true" />

                <!-- Air quality chip (IPU), split from the weather line by HomeText. -->
                <TextView
                    android:id="@+id/aqiChip"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tn_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="?attr/tnText"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:visibility="gone" />
                <!-- Amaran Cuaca Buruk / Ribut Petir (Sebelah Weather) -->
                <LinearLayout
                    android:id="@+id/weatherWarningPill"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_marginStart="8dp"
                    android:paddingEnd="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tn_chip_warning"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone">

                    <!-- Inner clickable area for opening warning details dialog -->
                    <LinearLayout
                        android:id="@+id/weatherWarningContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/tn_focus_ring_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:id="@+id/weatherWarningIcon"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:src="@drawable/tn_dot"
                            android:tint="?attr/tnAmber"
                            android:contentDescription="Amaran Cuaca" />

                        <TextView
                            android:id="@+id/weatherWarningText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:maxWidth="500dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="?attr/tnAmber"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:textFontWeight="500"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Dedicated Close "X" Button to dismiss/hide warning -->
                    <ImageView
                        android:id="@+id/btnWarningDismiss"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/tn_chip_round"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="Tutup Amaran" />
                </LinearLayout>
            </LinearLayout>

            <!-- Now Playing Widget Card: Matching bravia-glass-tv design -->
            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_below="@id/weatherRow"
                android:layout_alignParentStart="true"
                android:layout_marginTop="12dp"
                android:focusable="false"
                android:visibility="gone"
                android:background="@drawable/glass_panel"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_media_app_pill"
                    android:src="@drawable/ic_music"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/cardTrackInfo" />

                <LinearLayout
                    android:id="@+id/cardTrackInfo"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_track_info_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/cardAlbumArt"
                    android:nextFocusRight="@+id/btnInlinePrev">

                    <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now playing • SPOTIFY"
                        android:textColor="?attr/tnMuted"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500"
                        android:letterSpacing="0.04"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Song Title"
                        android:textColor="?attr/tnText"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:textFontWeight="500"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />
                </LinearLayout>

                <!-- Inline Media Controls: Prev, Play/Pause, Next (Round buttons with ic_np_tint) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnInlinePrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/cardTrackInfo"
                        android:nextFocusRight="@+id/btnInlinePlayPause" />

                    <ImageView
                        android:id="@+id/btnInlinePlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePrev"
                        android:nextFocusRight="@+id/btnInlineNext" />

                    <ImageView
                        android:id="@+id/btnInlineNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePlayPause"
                        android:nextFocusRight="@+id/btnInlineClose" />

                    <ImageView
                        android:id="@+id/btnInlineClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlineNext" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top Menu Buttons: Strictly in the same row, vertically centered with the clock -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/leftBlock"
                android:layout_alignBottom="@id/leftBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnAssistant"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Google Assistant"
                    android:drawableStart="@drawable/ic_mic" />

                <FrameLayout
                    android:id="@+id/btnCandyBox"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:foreground="@drawable/avatar_glass_border"
                    android:contentDescription="Select User &amp; Child Mode"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieHomeAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnSettingsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopMenuButton"
                        android:layout_width="42dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="0dp"
                        android:drawablePadding="0dp"
                        android:contentDescription="@string/settings"
                        android:drawableStart="@drawable/ic_settings" />

                    <View
                        android:id="@+id/badgeSettingsUpdate"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="3dp"
                        android:visibility="gone"
                        android:background="@drawable/badge_dot_red" />
                </FrameLayout>
            </LinearLayout>

            <!-- Fallback Prayer Times view -->
            <TextView
                android:id="@+id/prayerTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/weatherRow"
                android:layout_alignParentStart="true"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

</FrameLayout>
