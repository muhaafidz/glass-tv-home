<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted liquid glass border overlay for circular profile avatars (ReactDrops Soap Bubble style) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#1F2EF2C0" />
            <stroke android:width="2.5dp" android:color="?attr/tnAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#552EF2C0" />
        </shape>
    </item>
</selector>
