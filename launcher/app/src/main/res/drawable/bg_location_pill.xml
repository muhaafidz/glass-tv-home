<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sinar_accent" />
            <corners android:radius="14dp" />
            <padding android:left="14dp" android:top="5dp" android:right="14dp" android:bottom="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sinar_surface" />
            <stroke android:width="1dp" android:color="@color/sinar_hairline" />
            <corners android:radius="14dp" />
            <padding android:left="14dp" android:top="5dp" android:right="14dp" android:bottom="5dp" />
        </shape>
    </item>
</selector>
