<?xml version="1.0" encoding="utf-8"?>
<!-- Tenang card: translucent fill over the ambient background, one hairline, no shadow.
     Focusable cards show the accent ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="?attr/tnCard" />
            <stroke android:width="2dp" android:color="?attr/tnAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="?attr/tnCard" />
            <stroke android:width="1dp" android:color="?attr/tnLine" />
        </shape>
    </item>
</selector>
