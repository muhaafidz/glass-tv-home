<?xml version="1.0" encoding="utf-8"?>
<!-- Tenang pill (info chips, buttons): chip fill, hairline; focused adds the accent ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="?attr/tnChip" />
            <stroke android:width="2dp" android:color="?attr/tnAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="?attr/tnChip" />
            <stroke android:width="1dp" android:color="?attr/tnLine" />
        </shape>
    </item>
</selector>
