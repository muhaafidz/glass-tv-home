<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6127777" />
            <stroke
                android:width="2dp"
                android:color="@color/canvas_teal_focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A80B1422" />
            <stroke
                android:width="1dp"
                android:color="#4A7895AA" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
