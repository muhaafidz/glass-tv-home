<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown bar: accent into warm. Its length is a scaleX, so it never re-lays out. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient android:angle="0" android:startColor="?attr/tnAccent" android:endColor="?attr/tnWarm" />
</shape>
