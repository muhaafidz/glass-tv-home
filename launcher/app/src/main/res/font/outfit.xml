<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit (SIL OFL 1.1, launcher/FONT-LICENSE-OFL.txt): static weights cut from the variable font,
     hinting removed. Normal text uses 400 and bold 700. On Android 8 (no textFontWeight) the lighter cuts are
     referenced directly: @font/outfit_extralight for the clock, @font/outfit_light for body text. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/outfit_extralight" android:fontStyle="normal" android:fontWeight="200"
        app:font="@font/outfit_extralight" app:fontStyle="normal" app:fontWeight="200" />
    <font android:font="@font/outfit_light" android:fontStyle="normal" android:fontWeight="300"
        app:font="@font/outfit_light" app:fontStyle="normal" app:fontWeight="300" />
    <font android:font="@font/outfit_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/outfit_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/outfit_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/outfit_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/outfit_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/outfit_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
