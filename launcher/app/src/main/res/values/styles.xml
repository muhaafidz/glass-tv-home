<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/tenang_malam_bg1</item>
        <item name="android:colorBackground">@color/tenang_malam_bg1</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="tnBg1">#0C1A26</item>
        <item name="tnBg2">#16303A</item>
        <item name="tnBlobA">#5758AAAA</item>
        <item name="tnBlobB">#427C74C8</item>
        <item name="tnSurface">#182531</item>
        <item name="tnSurfaceRaised">#1F2C37</item>
        <item name="tnSurfaceFocus">#27333E</item>
        <item name="tnHairline">#222F3A</item>
        <item name="tnCard">#0DFFFFFF</item>
        <item name="tnChip">#12FFFFFF</item>
        <item name="tnLine">#17FFFFFF</item>
        <item name="tnText">#E9F0F1</item>
        <item name="tnMuted">#8FA6AB</item>
        <item name="tnAccent">#9FD8C9</item>
        <item name="tnAccentSoft">#1F9FD8C9</item>
        <item name="tnAccentDim">#7FC4B3</item>
        <item name="tnAccentGlow">#739FD8C9</item>
        <item name="tnOnAccent">#0C1A26</item>
        <item name="tnWarm">#F1D3A1</item>
        <item name="tnAmber">#F2C27B</item>
        <item name="tnAmberBg">#1FF2C27B</item>
        <item name="tnGood">#8FD6A5</item>
        <item name="tnCoral">#F08A8A</item>
        <item name="tnCyan">#8CCFE6</item>
        <item name="tnViolet">#A79BE8</item>
        <item name="tnWave">#12FFFFFF</item>
        <item name="tnStars">1.0</item>
        <item name="tnIsLight">false</item>
    </style>

    <style name="Theme.TvHome.Translucent" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.TvHome.AzanCard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Toast</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.TvHome.GlassDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:textColor">?attr/tnText</item>
        <item name="android:textColorPrimary">?attr/tnText</item>
        <item name="android:textColorSecondary">?attr/tnMuted</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:windowTitleStyle">@style/GlassDialogTitle</item>
        <item name="android:textAppearanceMedium">@style/GlassDialogMessage</item>
        <item name="android:buttonBarStyle">@style/GlassDialogButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/GlassDialogButton</item>
    </style>

    <style name="GlassDialogTitle" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/tnText</item>
    </style>

    <style name="GlassDialogMessage" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/tnMuted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="GlassDialogButtonBar" parent="android:Widget.Material.ButtonBar">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="GlassDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/tnAccent</item>
    </style>

    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />
    <style name="TopMenuButton" parent="TopButton">
        <item name="android:textColor">@drawable/top_text</item>
        <item name="android:drawableTint">@drawable/top_text</item>
    </style>
</resources>
