<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sinar_canvas</item>
        <item name="android:colorBackground">@color/sinar_canvas</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.TvHome.Translucent" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.TvHome.AzanCard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Toast</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.TvHome.GlassDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:textColor">@color/sinar_text</item>
        <item name="android:textColorPrimary">@color/sinar_text</item>
        <item name="android:textColorSecondary">@color/sinar_text_muted</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:windowTitleStyle">@style/GlassDialogTitle</item>
        <item name="android:textAppearanceMedium">@style/GlassDialogMessage</item>
        <item name="android:buttonBarStyle">@style/GlassDialogButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/GlassDialogButton</item>
    </style>

    <style name="GlassDialogTitle" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/sinar_text</item>
    </style>

    <style name="GlassDialogMessage" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/sinar_text_muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="GlassDialogButtonBar" parent="android:Widget.Material.ButtonBar">
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="GlassDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/sinar_accent</item>
    </style>

    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />
    <style name="TopMenuButton" parent="TopButton">
        <item name="android:textColor">@drawable/top_text</item>
        <item name="android:drawableTint">@drawable/top_text</item>
    </style>
</resources>
