<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tenang Malam, fixed: only for places that cannot read the activity's theme (the window
         background before the first frame, notifications). Everything else uses ?attr/tn… tokens. -->
    <color name="tenang_malam_bg1">#0C1A26</color>

    <!-- Legacy Sinar names, now Malam values, kept so an older theme or a missed reference still
         resolves. New code must not use them. -->
    <color name="sinar_canvas">#0C1A26</color>
    <color name="sinar_surface">#182531</color>
    <color name="sinar_surface_raised">#1F2C37</color>
    <color name="sinar_surface_focus">#27333E</color>
    <color name="sinar_hairline">#222F3A</color>
    <color name="sinar_text">#E9F0F1</color>
    <color name="sinar_text_muted">#8FA6AB</color>
    <color name="sinar_accent">#9FD8C9</color>
    <color name="sinar_accent_soft">#1F9FD8C9</color>
    <color name="sinar_accent_dim">#7FC4B3</color>
    <color name="sinar_on_accent">#0C1A26</color>
    <color name="sinar_cyan">#8CCFE6</color>
    <color name="sinar_violet">#A79BE8</color>
    <color name="sinar_amber">#F2C27B</color>
    <color name="sinar_coral">#F08A8A</color>

    <!-- Legacy aliases kept so themes and layouts keep resolving. -->
    <color name="canvas_ink">@color/sinar_canvas</color>
    <color name="canvas_panel_top">@color/sinar_surface</color>
    <color name="canvas_panel_bottom">@color/sinar_surface</color>
    <color name="canvas_panel_stroke">@color/sinar_hairline</color>
    <color name="canvas_teal">@color/sinar_accent</color>
    <color name="canvas_teal_focus">@color/sinar_accent</color>
    <color name="canvas_text_muted">@color/sinar_text_muted</color>
    <color name="canvas_amber">@color/sinar_amber</color>
    <color name="canvas_divider">@color/sinar_hairline</color>
</resources>
